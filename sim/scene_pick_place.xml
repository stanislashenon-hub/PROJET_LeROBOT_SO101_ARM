<!--
  ════════════════════════════════════════════════════════════
  scene_pick_place.xml
  Scène MuJoCo SO101 — Pick & Place
  Cube et corbeille placés à mi-course (25 cm) du bras
  ════════════════════════════════════════════════════════════
-->
<mujoco model="scene_pick_place">

  <!-- ── Inclure le bras SO101 ────────────────────────────── -->
  <include file="so101_new_calib.xml" />

  <!-- ── Options physiques optimisées pour la préhension ─── -->
  <option timestep="0.002" integrator="implicitfast"
          cone="elliptic" impratio="10"/>

  <!-- ── Paramètres visuels ───────────────────────────────── -->
  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="160" elevation="-20"/>
  </visual>

  <!-- ── Assets (textures / matériaux) ───────────────────── -->
  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7"
             rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker"
             mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
             markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane"
              texuniform="true" texrepeat="5 5" reflectance="0.2"/>
  </asset>

  <!-- ── Corps du monde ───────────────────────────────────── -->
  <worldbody>

    <!-- Éclairage directionnel principal -->
    <light pos="0 0 3.5" dir="0 0 -1" directional="true"
           diffuse="0.8 0.8 0.8" specular="0.2 0.2 0.2" castshadow="true"/>

    <!-- Éclairage d'appoint latéral -->
    <light pos="1 -1 2" dir="-1 1 -1" directional="true"
           diffuse="0.3 0.3 0.3" specular="0.0 0.0 0.0" castshadow="false"/>

    <!-- Sol -->
    <geom name="floor" size="0 0 0.05" type="plane"
          material="groundplane" friction="1 0.005 0.0001"
          conaffinity="1" condim="3"/>

    <!-- ════════════════════════════════════════════════════
         BLOC BLEU À ATTRAPER
         Position : 25 cm devant, 12 cm à droite (y = +0.12)
         → mi-course du bras, atteignable sans tension
         ════════════════════════════════════════════════════ -->
    <body name="blue_block" pos="0.25 0.12 0.02">
      <freejoint name="blue_block_joint"/>
      <geom name="blue_block_geom"
            type="box"
            size="0.015 0.015 0.015"
            rgba="0.1 0.3 0.9 1"
            mass="0.03"
            friction="1.5 0.05 0.001"
            conaffinity="1"
            condim="6"
            solimp="0.95 0.99 0.001"
            solref="0.005 1"/>
    </body>

    <!-- ════════════════════════════════════════════════════
         CORBEILLE DE DÉPÔT
         Position : 25 cm devant, 12 cm à gauche (y = -0.12)
         → symétrique du cube, accès par rotation shoulder_pan
         ════════════════════════════════════════════════════ -->
    <body name="bin" pos="0.25 -0.12 0.0">
      <!-- Fond -->
      <geom name="bin_floor"
            type="box"
            pos="0 0 0.003"
            size="0.06 0.06 0.003"
            rgba="0.8 0.2 0.2 1"
            conaffinity="1"
            condim="3"/>

      <!-- Paroi droite (+x) -->
      <geom name="bin_wall_px"
            type="box"
            pos="0.06 0 0.03"
            size="0.003 0.06 0.03"
            rgba="0.8 0.2 0.2 0.5"
            conaffinity="1"
            condim="3"/>

      <!-- Paroi gauche (-x) -->
      <geom name="bin_wall_nx"
            type="box"
            pos="-0.06 0 0.03"
            size="0.003 0.06 0.03"
            rgba="0.8 0.2 0.2 0.5"
            conaffinity="1"
            condim="3"/>

      <!-- Paroi avant (+y) -->
      <geom name="bin_wall_py"
            type="box"
            pos="0 0.06 0.03"
            size="0.06 0.003 0.03"
            rgba="0.8 0.2 0.2 0.5"
            conaffinity="1"
            condim="3"/>

      <!-- Paroi arrière (-y) -->
      <geom name="bin_wall_ny"
            type="box"
            pos="0 -0.06 0.03"
            size="0.06 0.003 0.03"
            rgba="0.8 0.2 0.2 0.5"
            conaffinity="1"
            condim="3"/>
    </body>

  </worldbody>

  <!-- ════════════════════════════════════════════════════════
       CONTACT PAIRS (à activer plus tard)
       Pour trouver les noms des doigts :
         grep -E "geom .*name=" so101_new_calib.xml | grep -iE "finger|jaw|grip|tip|pad"
  ════════════════════════════════════════════════════════════ -->
  <!--
  <contact>
    <pair geom1="blue_block_geom" geom2="NOM_DOIGT_GAUCHE"
          friction="2.5 2.5 0.1 0.05 0.05"
          solref="0.005 1" solimp="0.95 0.99 0.001"/>
    <pair geom1="blue_block_geom" geom2="NOM_DOIGT_DROIT"
          friction="2.5 2.5 0.1 0.05 0.05"
          solref="0.005 1" solimp="0.95 0.99 0.001"/>
  </contact>
  -->

</mujoco>
